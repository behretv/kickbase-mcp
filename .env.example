# Plain values...
KICKBASE_EMAIL=you@example.com
KICKBASE_PASSWORD=your-password

# ...or Proton Pass secret references (requires launching via
# `pass-cli run --env-file .env -- <command>`):
# KICKBASE_EMAIL="pass://MyVault/Kickbase/email"
# KICKBASE_PASSWORD="pass://MyVault/Kickbase/password"

# Optional: pin a league if you are in more than one
# KICKBASE_LEAGUE_ID=1234567
